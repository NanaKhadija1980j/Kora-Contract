{
  "name": "@kora/keeper",
  "version": "1.0.0",
  "description": "Kora Protocol \u2014 Background job/keeper service for deadline-based contract triggers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node init && tsc",
    "start": "node init && node dist/index.js",
    "dev": "node init && ts-node src/index.ts",
    "test": "jest --coverage --coverageThreshold='{\"global\":{\"lines\":90,\"branches\":90,\"functions\":90,\"statements\":90}}'",
    "test:watch": "jest --watch",
    "lint": "eslint src tests --ext .ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "better-sqlite3": "9.4.3",
    "pino": "9.1.0",
    "pino-pretty": "11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.10",
    "@types/jest": "29.5.12",
    "@types/node": "20.12.12",
    "jest": "29.7.0",
    "ts-jest": "29.1.4",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
